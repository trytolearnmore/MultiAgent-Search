# ===========================================
# MultiAgent-Search - 环境变量配置模板
# 复制此文件为 .env 并填入你的真实配置
# ===========================================

# ---------- RAGFlow 知识库服务 ----------
RAGFLOW_API_URL=http://your-ragflow-server-ip
RAGFLOW_API_KEY=your-ragflow-api-key

# ---------- LLM 大模型配置 ----------
# 使用 OpenAI 兼容协议，可接入通义千问、DeepSeek、OpenAI 等
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key

# 模型名称（根据你的服务商填写）
LLM_QWEN2.5=qwen2.5-14b-instruct
LLM_QWEN3=qwen3-32b
LLM_QWEN_MAX=qwen-max

# ---------- Agent 行为开关 ----------
# true: 子智能体完成任务后进行自检；false: 关闭反思，用于 A/B 评测
# 修改后需要重启后端服务
ENABLE_REFLECTION=true

# 单个用户任务允许实际执行的网络搜索次数（执行层硬限制）
# 修改后需要重启后端服务
MAX_NETWORK_SEARCHES=10

# 单个用户任务允许执行的自定义 SQL 查询次数
MAX_DATABASE_QUERIES=5

# ---------- Tavily 网络搜索 ----------
# 注册地址: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

# ---------- MySQL 数据库 ----------
MYSQL_USER=your-db-user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=your-database-name
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Agent 单次查询最多返回的行数
MYSQL_QUERY_MAX_ROWS=100
# MySQL 单条 SELECT 最长执行时间（毫秒）
MYSQL_QUERY_MAX_EXECUTION_MS=5000
